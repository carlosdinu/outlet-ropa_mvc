              <text value="Zapatilla"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="p002" binding="panelDatos" layout-manager="GridLayoutManager" row-count="10" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="6">
