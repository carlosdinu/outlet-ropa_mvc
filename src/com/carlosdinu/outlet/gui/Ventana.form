        <properties/>
        <border type="none"/>
        <children>
          <component id="c023" class="javax.swing.JLabel" binding="tituloLbl">
            <constraints/>
            <properties>
              <text value="OUTLET  -  Tipo de prenda:"/>
            </properties>
          </component>
          <component id="c020" class="javax.swing.JRadioButton" binding="camisetaRadioButton">
            <constraints/>
            <properties>
