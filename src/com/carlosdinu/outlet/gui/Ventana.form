<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.carlosdinu.outlet.gui.Ventana">
  <grid id="27dc6" binding="panel1" layout-manager="BorderLayout" hgap="10" vgap="10">
    <constraints>
      <xy x="20" y="20" width="820" height="520"/>
    </constraints>
    <properties/>
    <border type="empty">
      <size top="10" left="10" bottom="10" right="10"/>
    </border>
    <children>
      <grid id="p001" binding="panelRadios" layout-manager="FlowLayout" hgap="10" vgap="5" flow-align="0">
